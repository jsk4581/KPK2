# Public URL of the Decision Brain server (rules only, no AI). No secrets here.
# Copy to .env.local and fill in; leave empty to show the on-device signals only.
VITE_BRAIN_URL=<public brain URL>
# Optional second public URL of the same brain server. Tried when the primary fails
# (network error, timeout, 5xx, 408, 429 or a bad answer); leave empty for none.
VITE_BRAIN_URL_BACKUP=<backup public brain URL>
